# Build context is the dauth module root:
#   docker build -f docker/dockerfile.token-exchange-api .
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# go-ethereum and the rest of token-exchange's deps build CGO-free, so this is a
# fully static binary shipped on distroless/static (matching the dauth image).
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /token-exchange-api ./cmd/token-exchange-api

FROM gcr.io/distroless/static AS final
LABEL maintainer="DIMO <hello@dimo.zone>"
USER nonroot:nonroot
COPY --from=build /token-exchange-api /
# 8080 HTTP (exchange + JWKS), 8888 ops/metrics, 8086 gRPC AccessCheck.
EXPOSE 8080 8888 8086
ENTRYPOINT ["/token-exchange-api"]
