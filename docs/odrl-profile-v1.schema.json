{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ns.dimo.co/odrl/v1/schema.json",
  "title": "DIMO ODRL Profile v1 Agreement",
  "description": "The data payload of a dimo.sacd.odrl CloudEvent. Fail-closed: anything not described here is rejected by the evaluator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["@context", "@type", "profile", "assigner", "assignee", "target", "permission"],
  "properties": {
    "@context": {
      "oneOf": [
        { "const": "http://www.w3.org/ns/odrl.jsonld" },
        {
          "type": "array",
          "prefixItems": [
            { "const": "http://www.w3.org/ns/odrl.jsonld" },
            { "const": "https://ns.dimo.co/odrl/v1" }
          ],
          "minItems": 1,
          "maxItems": 2,
          "items": false
        }
      ]
    },
    "@type": { "const": "Agreement" },
    "uid": { "type": "string", "format": "uri" },
    "profile": { "const": "https://ns.dimo.co/odrl/v1" },
    "assigner": {
      "type": "string",
      "pattern": "^did:ethr:[0-9]+:0x[0-9a-fA-F]{40}$",
      "description": "Grantor: the party whose signature covers the CloudEvent data bytes."
    },
    "assignee": {
      "type": "string",
      "pattern": "^did:ethr:[0-9]+:0x[0-9a-fA-F]{40}$",
      "description": "Grantee: the party permitted to exchange this grant for a token."
    },
    "target": {
      "type": "string",
      "pattern": "^did:(erc721|ethr):[0-9]+:0x[0-9a-fA-F]{40}(:[0-9]+)?$",
      "description": "The asset the permissions apply to."
    },
    "constraint": {
      "type": "array",
      "description": "Validity period as conjunctive dateTime comparisons. Absent means unbounded.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["leftOperand", "operator", "rightOperand"],
        "properties": {
          "leftOperand": { "const": "dateTime" },
          "operator": { "enum": ["gteq", "gt", "lteq", "lt"] },
          "rightOperand": { "type": "string", "format": "date-time" }
        }
      }
    },
    "permission": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action"],
        "properties": {
          "action": {
            "type": "string",
            "pattern": "^privilege:[A-Za-z]+$",
            "description": "A DIMO permission name from the profile's closed action vocabulary."
          }
        }
      }
    }
  }
}
